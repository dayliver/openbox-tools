  <keyboard>
    <rebindOnMappingNotify>yes</rebindOnMappingNotify>
    <chainQuitKey>C-g</chainQuitKey>
    <!-- ######## Global Actions ######## -->
    <!-- Action : ShowMenu -->
    <keybind key="W-space">
      <action name="ShowMenu">
        <menu>root-menu</menu>
      </action>
    </keybind>
    <keybind key="A-space">
      <action name="ShowMenu">
        <menu>client-menu</menu>
      </action>
    </keybind>
    <keybind key="A-S-space">
      <action name="ShowMenu">
        <menu>client-list-combined-menu</menu>
      </action>
    </keybind>
    <keybind key="C-A-space">
      <action name="ShowMenu">
        <menu>app-menu</menu>
      </action>
    </keybind>
    <!-- Action : {Next,Previous}Window -->
    <keybind key="W-Tab">
      <action name="NextWindow">
        <dialog>list</dialog>
        <bar>no</bar>
        <raise>yes</raise>
        <allDesktops>yes</allDesktops>
        <panels>no</panels>
        <desktop>no</desktop>
        <linear>no</linear>
        <interactive>yes</interactive>
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
        </finalactions>
      </action>
    </keybind>
    <keybind key="W-S-Tab">
      <action name="PreviousWindow">
        <dialog>list</dialog>
        <bar>no</bar>
        <raise>yes</raise>
        <allDesktops>yes</allDesktops>
        <panels>no</panels>
        <desktop>no</desktop>
        <linear>no</linear>
        <interactive>yes</interactive>
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
        </finalactions>
      </action>
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow">
        <dialog>list</dialog>
        <bar>no</bar>
        <raise>yes</raise>
        <allDesktops>no</allDesktops>
        <panels>no</panels>
        <desktop>no</desktop>
        <linear>no</linear>
        <interactive>yes</interactive>
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
        </finalactions>
      </action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow">
        <dialog>list</dialog>
        <bar>no</bar>
        <raise>yes</raise>
        <allDesktops>no</allDesktops>
        <panels>no</panels>
        <desktop>no</desktop>
        <linear>no</linear>
        <interactive>yes</interactive>
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
        </finalactions>
      </action>
    </keybind>
    <!-- Action : GoToDesktop -->
    <keybind key="C-A-Right">
      <action name="GoToDesktop">
        <to>next</to>
        <wrap>yes</wrap>
      </action>
    </keybind>
    <keybind key="C-A-Left">
      <action name="GoToDesktop">
        <to>previous</to>
        <wrap>yes</wrap>
      </action>
    </keybind>
    <keybind key="W-1">
      <action name="GoToDesktop">
        <to>1</to>
      </action>
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop">
        <to>2</to>
      </action>
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop">
        <to>3</to>
      </action>
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop">
        <to>4</to>
      </action>
    </keybind>
    <keybind key="W-5">
      <action name="GoToDesktop">
        <to>5</to>
      </action>
    </keybind>
    <!-- Action : Add/Remove Desktop -->
    <keybind key="W-equal">
      <action name="AddDesktop">
        <where>last</where>
      </action>
      <action name="Execute">
        <command>dunstify -u low -h string:x-dunst-stack-tag:obaction "Added New Desktop"</command>
      </action>
    </keybind>
    <keybind key="W-minus">
      <action name="RemoveDesktop">
        <where>last</where>
      </action>
      <action name="Execute">
        <command>dunstify -u low -h string:x-dunst-stack-tag:obaction "Removed Last Desktop"</command>
      </action>
    </keybind>
    <!-- Action : ToggleShowDesktop -->
    <keybind key="W-d">
      <action name="ToggleShowDesktop"/>
    </keybind>
    <!-- Action : Session -->
    <keybind key="C-S-R">
      <action name="Execute">
        <command>dunstify -u low -h string:x-dunst-stack-tag:obaction "Configuration Reloaded!"</command>
      </action>
      <action name="Reconfigure"/>
    </keybind>
    <keybind key="C-S-BackSpace">
      <action name="Restart"/>
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Exit">
        <prompt>yes</prompt>
      </action>
    </keybind>
    <!-- ######## Window Actions ######## -->
    <!-- Action : SendToDesktop -->
    <keybind key="W-S-Right">
      <action name="SendToDesktop">
        <to>next</to>
        <wrap>yes</wrap>
        <follow>yes</follow>
      </action>
    </keybind>
    <keybind key="W-S-Left">
      <action name="SendToDesktop">
        <to>previous</to>
        <wrap>yes</wrap>
        <follow>yes</follow>
      </action>
    </keybind>
    <keybind key="S-W-1">
      <action name="SendToDesktop">
        <desktop>1</desktop>
      </action>
    </keybind>
    <keybind key="S-W-2">
      <action name="SendToDesktop">
        <desktop>2</desktop>
      </action>
    </keybind>
    <keybind key="S-W-3">
      <action name="SendToDesktop">
        <desktop>3</desktop>
      </action>
    </keybind>
    <keybind key="S-W-4">
      <action name="SendToDesktop">
        <desktop>4</desktop>
      </action>
    </keybind>
    <keybind key="S-W-5">
      <action name="SendToDesktop">
        <desktop>5</desktop>
      </action>
    </keybind>
    <!-- Action : MoveRelative -->
    <keybind key="W-A-Up">
      <action name="MoveRelative">
        <x>0</x>
        <y>-20</y>
      </action>
    </keybind>
    <keybind key="W-A-Down">
      <action name="MoveRelative">
        <x>0</x>
        <y>20</y>
      </action>
    </keybind>
    <keybind key="W-A-Left">
      <action name="MoveRelative">
        <x>-20</x>
        <y>0</y>
      </action>
    </keybind>
    <keybind key="W-A-Right">
      <action name="MoveRelative">
        <x>20</x>
        <y>0</y>
      </action>
    </keybind>
    <!-- Action : ResizeRelative -->
    <keybind key="W-C-Right">
      <action name="ResizeRelative">
        <right>20</right>
      </action>
    </keybind>
    <keybind key="W-C-Left">
      <action name="ResizeRelative">
        <right>-20</right>
      </action>
    </keybind>
    <keybind key="W-C-Down">
      <action name="ResizeRelative">
        <bottom>20</bottom>
      </action>
    </keybind>
    <keybind key="W-C-Up">
      <action name="ResizeRelative">
        <bottom>-20</bottom>
      </action>
    </keybind>
    <!-- Action: Interactive Move/Resize -->
    <keybind key="W-A-m">
      <action name="Execute">
        <command>dunstify -u low -h string:x-dunst-stack-tag:obaction "Begin Interactive Moving"</command>
      </action>
      <action name="Move"/>
    </keybind>
    <keybind key="W-A-r">
      <action name="Execute">
        <command>dunstify -u low -h string:x-dunst-stack-tag:obaction "Begin Interactive Resizing"</command>
      </action>
      <action name="Resize"/>
    </keybind>
    <!-- Window Tiling: Snap feature -->
    <keybind key="W-Left">
      <action name="UnmaximizeFull"/>
      <action name="MaximizeVert"/>
      <action name="MoveResizeTo">
        <width>50%</width>
      </action>
      <action name="MoveToEdgeWest"/>
    </keybind>
    <keybind key="W-Right">
      <action name="UnmaximizeFull"/>
      <action name="MaximizeVert"/>
      <action name="MoveResizeTo">
        <width>50%</width>
      </action>
      <action name="MoveToEdgeEast"/>
    </keybind>
    <keybind key="W-Up">
      <action name="MaximizeFull"/>
    </keybind>
    <keybind key="W-Down">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <width>60%</width>
        <height>80%</height>
      </action>
      <action name="MoveToCenter"/>
    </keybind>
    <keybind key="W-S-Up">
      <action name="UnmaximizeFull"/>
      <action name="Maximize">
        <direction>horizontal</direction>
      </action>
      <action name="MoveResizeTo">
        <height>50%</height>
      </action>
      <action name="MoveToEdgeNorth"/>
    </keybind>
    <keybind key="W-S-Down">
      <action name="UnmaximizeFull"/>
      <action name="Maximize">
        <direction>horizontal</direction>
      </action>
      <action name="MoveResizeTo">
        <height>50%</height>
      </action>
      <action name="MoveToEdgeSouth"/>
    </keybind>
    <!-- Top right-->
    <keybind key="W-k">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>-0</x>
        <y>0</y>
      </action>
    </keybind>
    <keybind key="W-S-k">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>-0</x>
        <y>0</y>
        <width>50%</width>
        <height>50%</height>
      </action>
    </keybind>
    <!-- Top left-->
    <keybind key="W-h">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>0</y>
      </action>
    </keybind>
    <keybind key="W-S-h">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>0</y>
        <width>50%</width>
        <height>50%</height>
      </action>
    </keybind>
    <!-- Bottom left-->
    <keybind key="W-j">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>-0</y>
      </action>
    </keybind>
    <keybind key="W-S-j">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>-0</y>
        <width>50%</width>
        <height>50%</height>
      </action>
    </keybind>
    <!-- Bottom right-->
    <keybind key="W-l">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>-0</x>
        <y>-0</y>
      </action>
    </keybind>
    <keybind key="W-S-l">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>-0</x>
        <y>-0</y>
        <width>50%</width>
        <height>50%</height>
      </action>
    </keybind>
    <!-- Windows Tiling -->
    <keybind key="W-KP_1">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>-0</y>
        <width>50%</width>
        <height>50%</height>
      </action>
    </keybind>
    <keybind key="W-KP_2">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>-0</y>
        <width>100%</width>
        <height>50%</height>
      </action>
    </keybind>
    <keybind key="W-KP_3">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>-0</x>
        <y>-0</y>
        <width>50%</width>
        <height>50%</height>
      </action>
    </keybind>
    <keybind key="W-KP_4">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>0</y>
        <width>50%</width>
        <height>100%</height>
      </action>
    </keybind>
    <keybind key="W-KP_5">
      <action name="MaximizeFull"/>
    </keybind>
    <keybind key="W-KP_6">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>-0</x>
        <y>0</y>
        <width>50%</width>
        <height>100%</height>
      </action>
    </keybind>
    <keybind key="W-KP_7">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>0</y>
        <width>50%</width>
        <height>50%</height>
      </action>
    </keybind>
    <keybind key="W-KP_8">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>0</y>
        <width>100%</width>
        <height>50%</height>
      </action>
    </keybind>
    <keybind key="W-KP_9">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>-0</x>
        <y>0</y>
        <width>50%</width>
        <height>50%</height>
      </action>
    </keybind>
    <!-- Action: Window -->
    <keybind key="W-c">
      <action name="Close"/>
    </keybind>
    <keybind key="W-q">
      <action name="Close"/>
    </keybind>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="A-F5">
      <action name="Iconify"/>
    </keybind>
    <keybind key="A-F6">
      <action name="ToggleMaximize"/>
    </keybind>
    <keybind key="A-F7">
      <action name="ToggleShade"/>
      <action name="Execute">
        <command>dunstify -u low -h string:x-dunst-stack-tag:obaction "Toggled Shade"</command>
      </action>
    </keybind>
    <keybind key="A-F8">
      <action name="ToggleDecorations"/>
      <action name="Execute">
        <command>dunstify -u low -h string:x-dunst-stack-tag:obaction "Toggled Decorations"</command>
      </action>
    </keybind>
    <keybind key="A-F9">
      <action name="ToggleOmnipresent"/>
      <action name="Execute">
        <command>dunstify -u low -h string:x-dunst-stack-tag:obaction "Toggled Omnipresent"</command>
      </action>
    </keybind>
    <keybind key="A-F10">
      <action name="ToggleFullscreen"/>
    </keybind>
    <keybind key="A-F11">
      <action name="ToggleAlwaysOnTop"/>
      <action name="Execute">
        <command>dunstify -u low -h string:x-dunst-stack-tag:obaction "Toggled Always-On-Top"</command>
      </action>
    </keybind>
    <keybind key="A-F12">
      <action name="ToggleAlwaysOnBottom"/>
      <action name="Execute">
        <command>dunstify -u low -h string:x-dunst-stack-tag:obaction "Toggled Always-On-Bottom"</command>
      </action>
    </keybind>
    <!-- ######## Actions: Execute ######## -->
    <!-- Screenshot Keys -->
    <keybind key="Print">
      <action name="Execute">
        <command>ob-screenshot --now</command>
      </action>
    </keybind>
    <keybind key="A-Print">
      <action name="Execute">
        <command>ob-screenshot --in5</command>
      </action>
    </keybind>
    <keybind key="S-Print">
      <action name="Execute">
        <command>ob-screenshot --in10</command>
      </action>
    </keybind>
    <keybind key="C-Print">
      <action name="Execute">
        <command>ob-screenshot --win</command>
      </action>
    </keybind>
    <keybind key="W-Print">
      <action name="Execute">
        <command>ob-screenshot --area</command>
      </action>
    </keybind>
    <!-- Brightness Control -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>ob-brightness --inc</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>ob-brightness --dec</command>
      </action>
    </keybind>
    <!-- Volume -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>ob-volume --inc</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>ob-volume --dec</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>ob-volume --toggle</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute">
        <command>ob-volume --toggle-mic</command>
      </action>
    </keybind>
    <!-- Media Controls -->
    <keybind key="XF86AudioStop">
      <action name="Execute">
        <command>mpc stop</command>
      </action>
    </keybind>
    <keybind key="XF86AudioPlay">
      <action name="Execute">
        <command>mpc toggle</command>
      </action>
    </keybind>
    <keybind key="XF86AudioPrev">
      <action name="Execute">
        <command>mpc prev</command>
      </action>
    </keybind>
    <keybind key="XF86AudioNext">
      <action name="Execute">
        <command>mpc next</command>
      </action>
    </keybind>
    <!-- ################################ Launch Applications ################################ -->
    <!-- Apps -->
    <keybind key="W-Return">
      <action name="Execute">
        <command>alacritty</command>
      </action>
    </keybind>
    <keybind key="W-S-Return">
      <action name="Execute">
        <command>kitty</command>
      </action>
    </keybind>
    <keybind key="W-f">
      <action name="Execute">
        <command>thunar</command>
      </action>
    </keybind>
    <keybind key="W-w">
      <action name="Execute">
        <command>firefox</command>
      </action>
    </keybind>
    <keybind key="W-e">
      <action name="Execute">
        <command>geany</command>
      </action>
    </keybind>
    <!-- Rofi -->
    <keybind key="A-F1">
      <action name="Execute">
        <command>rofi-launcher</command>
      </action>
    </keybind>
    <keybind key="W-n">
      <action name="Execute">
        <command>networkmanager_dmenu</command>
      </action>
    </keybind>
    <keybind key="W-b">
      <action name="Execute">
        <command>rofi-bluetooth</command>
      </action>
    </keybind>
    <keybind key="W-m">
      <action name="Execute">
        <command>rofi-music</command>
<!-- <command>rofi-spotify</command> -->
      </action>
    </keybind>
    <keybind key="W-x">
      <action name="Execute">
        <command>rofi-powermenu</command>
      </action>
    </keybind>
    <keybind key="W-s">
      <action name="Execute">
        <command>rofi-screenshot</command>
      </action>
    </keybind>
    <keybind key="W-r">
      <action name="Execute">
        <command>rofi-runner</command>
      </action>
    </keybind>
    <!-- CLI Apps -->
    <keybind key="C-A-t">
      <action name="Execute">
        <command>xfce4-terminal</command>
      </action>
    </keybind>
    <keybind key="C-A-v">
      <action name="Execute">
        <command>alacritty -e vim</command>
      </action>
    </keybind>
    <keybind key="C-A-r">
      <action name="Execute">
        <command>alacritty -e ranger</command>
      </action>
    </keybind>
    <keybind key="C-A-h">
      <action name="Execute">
        <command>alacritty -e htop</command>
      </action>
    </keybind>
    <!-- Misc -->
    <keybind key="C-A-l">
      <action name="Execute">
        <command>betterlockscreen --lock</command>
      </action>
    </keybind>
    <keybind key="W-t">
      <action name="Execute">
        <command>ob-furminal</command>
      </action>
    </keybind>
    <keybind key="W-p">
      <action name="Execute">
        <command>ob-colorpicker</command>
      </action>
    </keybind>
    <keybind key="C-A-m">
      <action name="Execute">
        <command>ob-music</command>
      </action>
    </keybind>
    <keybind key="W-Escape">
