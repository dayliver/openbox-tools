#!/usr/bin/env bash
set -euo pipefail
# Same look as Super+N: the current Archcraft style's network menu theme.
themes="$HOME/.config/openbox/themes"
rasi="$themes/$(cat "$themes/.current" 2>/dev/null || echo default)/rofi/networkmenu.rasi"
theme_args=()
if [[ -f "$rasi" ]]; then
    theme_args=(-theme "$rasi" -theme-str 'textbox-prompt-colon { str: "󰍹"; }')
fi
menu() { rofi -dmenu -i -p "$1" "${theme_args[@]}" "${@:2}"; }

options=('Arrange displays' 'Save current layout' 'Restore saved layout' 'Apply matching layout')
choice=$(printf '%s\n' "${options[@]}" | menu 'Displays' -no-custom) || exit 0
case "$choice" in
    "${options[0]}") exec arandr ;;
    "${options[1]}")
        name=$(menu 'Profile name' </dev/null) || exit 0
        [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || exit 1
        autorandr --save "$name"
        ;;
    "${options[2]}")
        name=$(autorandr --list | sed 's/ (.*)$//' | menu 'Restore layout' -no-custom) || exit 0
        autorandr --load "$name"
        ;;
    "${options[3]}")
        autorandr --change
        ;;
esac
