#!/usr/bin/env python3
"""Pick a saved RustDesk session from a Rofi menu and connect to it.

Sessions come from RustDesk's own files: favourites (`fav` in
RustDesk_local.toml) first, then every peer in peers/*.toml, most recently
used first. Only the ID, alias and [info] fields are read; stored passwords
are never touched.
"""
import os
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

FLATPAK = "com.rustdesk.RustDesk"
# A native `rustdesk` wins; otherwise use the Flatpak app and its own config.
if shutil.which("rustdesk"):
    COMMAND = ["rustdesk"]
    CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "rustdesk"
else:
    COMMAND = ["flatpak", "run", FLATPAK]
    CONF = Path.home() / ".var/app" / FLATPAK / "config/rustdesk"
THEMES = Path.home() / ".config/openbox/themes"
ICON = "\U000f08b9"  # nf-md-remote_desktop


def load(path):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def sessions():
    fav = [str(x) for x in load(CONF / "RustDesk_local.toml").get("fav", [])]
    peers = {}
    for path in (CONF / "peers").glob("*.toml"):
        data = load(path)
        info = data.get("info", {})
        alias = data.get("options", {}).get("alias", "")
        who = "@".join(x for x in (info.get("username"), info.get("hostname")) if x)
        detail = " · ".join(x for x in (who, info.get("platform", "")) if x)
        peers[path.stem] = (alias, detail, path.stat().st_mtime)
    for pid in fav:
        peers.setdefault(pid, ("", "", 0.0))
    order = sorted(peers, key=lambda p: (p not in fav, -peers[p][2]))
    return [(p, p in fav, *peers[p][:2]) for p in order]


def theme_args():
    style = "default"
    try:
        style = (THEMES / ".current").read_text().strip() or style
    except OSError:
        pass
    rasi = THEMES / style / "rofi/networkmenu.rasi"
    if not rasi.is_file():
        return []
    return ["-theme", str(rasi), "-theme-str",
            "\n".join([
                f'textbox-prompt-colon {{ str: "{ICON}"; }}',
                'mainbox { children: [ "inputbar", "message", "listview" ]; }',
                'message { padding: 12px; border-radius: 12px;'
                ' background-color: @background-alt; text-color: @foreground; }',
                'textbox { background-color: inherit; text-color: inherit; }'])]


def menu(prompt, lines, *extra):
    r = subprocess.run(["rofi", "-dmenu", "-i", "-p", prompt, *theme_args(), *extra],
                       input="\n".join(lines), capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def launch(*args):
    subprocess.Popen([*COMMAND, *args], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    peers = sessions()
    width = max([len(p) for p, *_ in peers] + [0])
    lines = []
    for pid, is_fav, alias, detail in peers:
        name = alias or detail or ""
        lines.append(f"{'★' if is_fav else ' '} {pid:<{width}}   {name}".rstrip())
    actions = ["Connect to ID…", "Open RustDesk"]
    mesg = ("Saved sessions: ★ favourites, then most recent" if peers else
            "No saved sessions yet. Connected IDs will appear here.")
    choice = menu("RustDesk", lines + actions, "-no-custom", "-format", "i", "-mesg", mesg)
    if choice is None or not choice.isdigit():
        return 0
    i = int(choice)
    if i < len(peers):
        launch("--connect", peers[i][0])
    elif i == len(peers):
        pid = menu("Remote ID", [], "-mesg", "RustDesk ID or IP address")
        if pid and " " not in pid:
            launch("--connect", pid)
    else:
        launch()
    return 0


if __name__ == "__main__":
    sys.exit(main())
